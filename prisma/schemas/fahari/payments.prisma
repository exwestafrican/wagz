enum ReservedAccountStatus {
  PENDING
  ACTIVE
  FAILED
  DEACTIVATED
}

enum ReservedAccountRequestStatus {
  PENDING
  SUCCESS
  FAILED
}

model ReservedAccount {
  id               Int                   @id @default(autoincrement())
  userId           Int
  accountPrefix    String                @db.VarChar(10)
  accountCode      Int                   @unique
  accountReference String                @unique @db.VarChar(100)
  accountNumber    String                @db.VarChar(20)
  bankCode         String                @db.VarChar(20)
  bankName         String                @db.VarChar(100)
  customerEmail    String                @db.VarChar(255)
  status           ReservedAccountStatus @default(ACTIVE)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reserved_account")
}

model ReservedAccountRequestLog {
  id             Int                          @id @default(autoincrement())
  accountPrefix  String                       @db.VarChar(10)
  accountCode    Int                          @unique @default(autoincrement())
  requestedBy    Int
  ownerId        Int
  status         ReservedAccountRequestStatus @default(PENDING)
  failureMessage String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  requester User @relation("ReservedAccountRequestRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  owner     User @relation("ReservedAccountRequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([requestedBy])
  @@index([ownerId])
  @@map("reserved_account_request_log")
}

model PaymentCollection {
  id                   Int       @id @default(autoincrement())
  transactionReference String    @unique @db.VarChar(100)
  accountReference     String    @db.VarChar(100)
  userId               Int
  amountPaid           Decimal   @db.Decimal(18, 2)
  paidOn               DateTime
  currency             String    @default("NGN") @db.VarChar(3)
  senderAccountNumber  String    @db.VarChar(20)
  senderAccountName    String    @db.VarChar(255)
  notifiedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountReference])
  @@map("payment_collection")
}
