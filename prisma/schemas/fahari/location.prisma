model Device {
  id        String   @id @default(cuid())
  imei      String   @unique
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations    Location[]
  apiKeys      DeviceApiKey[]
  deviceStates DeviceState[]

  @@map("device")
}

model DeviceApiKey {
  id        String    @id @default(cuid())
  deviceId  String
  keyHash   String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, isActive])
  @@map("device_api_key")
}

model Location {
  id            String @id @default(cuid())
  deviceId      String
  deviceStateId Int

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)
  speed     Decimal @default(0) @db.Decimal(8, 3)

  timestamp DateTime

  createdAt DateTime @default(now())

  device      Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceState DeviceState @relation(fields: [deviceStateId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([timestamp])
  @@index([deviceId, timestamp])
  @@map("location")
}

model DeviceState {
  id Int @id @default(autoincrement())

  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  geoTag String @db.VarChar(100) // e.g. HOME, Derive this from  geoTag entity.
  state  String @db.VarChar(100) // e.g. IN_MOTION, STOPPED, IDLE

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  locations Location[]

  //TODO: consider adding index to fetch by tag.
  @@map("device_state")
}
