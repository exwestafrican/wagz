enum RideRequestState {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TripType {
  PICK_UP
  ROUND_TRIP
}

model RideRequest {
  id                 Int              @id @default(autoincrement())
  experienceCode     String           @db.VarChar(50)
  numberOfPassengers Int
  pickupLocation     String           @db.VarChar(255)
  nearestLandmark    String?          @db.VarChar(255)
  pickupDateTime     DateTime
  departureDateTime  DateTime? // when do you want us to come and pick you up from drop off location
  firstName          String           @db.VarChar(100)
  tripType           TripType         @default(ROUND_TRIP)
  lastName           String           @db.VarChar(100)
  email              String           @db.VarChar(255)
  countryCallingCode String           @db.VarChar(8)
  nationalNumber     String           @db.VarChar(20)
  currency           String           @default("NGN") @db.VarChar(3)
  minorAmount        Int
  state              RideRequestState @default(PENDING)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("ride_request")
}
